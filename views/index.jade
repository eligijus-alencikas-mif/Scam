//- Scary scam page

doctype html
html
  head
    title !!!URGENT!!! Security Alert!!!
    style.
      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-10px); }
        20%, 40%, 60%, 80% { transform: translateX(10px); }
      }
      @keyframes rainbow {
        0% { color: red; }
        16% { color: orange; }
        33% { color: yellow; }
        50% { color: green; }
        66% { color: blue; }
        83% { color: indigo; }
        100% { color: violet; }
      }
      body {
        font-family: 'Comic Sans MS', 'Papyrus', cursive, fantasy;
        background: linear-gradient(45deg, #ff0000, #00ff00, #0000ff, #ffff00, #ff00ff);
        background-size: 400% 400%;
        animation: gradient 3s ease infinite;
        color: #ff0000;
        text-align: center;
        padding: 20px;
        margin: 0;
      }
      @keyframes gradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      h1 {
        font-size: 72px;
        animation: blink 0.5s infinite, shake 0.3s infinite;
        text-shadow: 5px 5px 10px #ff00ff, -5px -5px 10px #00ffff;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -3px;
      }
      p {
        font-size: 28px;
        animation: rainbow 2s infinite;
        background: yellow;
        border: 5px dashed red;
        padding: 10px;
        margin: 15px;
        transform: rotate(-2deg);
        box-shadow: 10px 10px 0px rgba(0,0,0,0.5);
      }
      .button {
        background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00);
        color: white;
        padding: 20px 40px;
        text-decoration: none;
        font-size: 32px;
        border: 10px solid #ff00ff;
        border-radius: 50px;
        animation: shake 0.2s infinite, rainbow 1s infinite;
        display: inline-block;
        margin: 20px;
        text-shadow: 3px 3px 5px black;
        font-weight: bold;
        cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><text y="24" font-size="24">💰</text></svg>'), auto;
      }
      .button:hover {
        transform: scale(1.3) rotate(5deg);
        background: linear-gradient(90deg, #00ff00, #ff00ff, #ffff00);
      }
      .warning {
        font-size: 48px;
        color: #ff0000;
        animation: blink 0.7s infinite;
        font-weight: 900;
      }
      .timer {
        font-size: 64px;
        color: #ff0000;
        background: black;
        padding: 20px;
        font-family: 'Courier New', monospace;
        animation: blink 1s infinite;
      }
      marquee {
        background: yellow;
        color: red;
        font-size: 36px;
        font-weight: bold;
        padding: 10px;
        border: 5px solid red;
      }
      
  body
    marquee(scrollamount="20") 🚨🚨🚨 DANGER!!! YOUR COMPUTOR IS IN DANGER!!! ACT NOW!!! 🚨🚨🚨
    h1 ⚠️⚠️⚠️URGENT SECURITY ALERT!!!⚠️⚠️⚠️
    p.warning !!!WARNING WARNING WARNING!!!
    p You're computer has been INFECTED by 347 VIRUSES and MALWARE!!!
    p IMEDIATE action is REQUIRED to prevent PERMANENT data loss!!!
    p.timer ⏰ TIME REMAINING: 04:59 ⏰
    a.button(href="https://totally-not-a-scam.example.com") 👉 CLICK HERE NOW TO FIX YOUR PC IMMEDIATLY!!! 👈
    p ⚠️ Failure to act NOW may result in COMPLETE SYSTEM FAILURE and IDENTITY THEFT!!!
    p Your IP address (192.168.1.1) has been logged and reported to MICROSOFT!!!
    marquee(direction="right" scrollamount="15") 💸💸💸 LIMITED TIME OFFER - ACT NOW!!! 💸💸💸
    p(style="font-size: 14px; color: gray;") *This is definitely a legitimate security warning from a reputable company
    p(style="transform: rotate(3deg);") Call our toll-free number NOW: 1-800-FAKE-NUM
    p(style="font-size: 40px;") 🔒 100% SAFE AND SECURE 🔒  